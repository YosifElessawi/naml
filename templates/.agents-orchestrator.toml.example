# agents-orchestrator — per-project config.
#
# Drop this at the root of a target repo (renamed to `.agents-orchestrator.toml`).
# The orchestrator walks up from cwd looking for this file, so `make burst` /
# `make slow` from anywhere inside the repo will find it.

[repo]
# GitHub slug — `gh` operates against this.
slug = "owner/repo-name"

# Optional. Default: the directory this config lives in.
# root = "/Users/me/Projects/repo-name"

# Branch all agent branches fork from and all PRs target.
base_branch = "master"


# Label state machine. Defaults are shown — override only if your repo uses
# different label names.
[labels]
ready      = "ready-for-agent"
running    = "agent-running"
done       = "agent-done"
failed     = "agent-failed"
needs_info = "needs-info"


# Local validation gates. Order matters — cheapest / most-likely-to-fail first.
# The first gate to fail stops the chain and triggers the resume-based retry.
#
# Examples:
#   JS / pnpm:
#     [[gates]]
#     name = "install"
#     argv = ["pnpm", "install", "--frozen-lockfile"]
#
#     [[gates]]
#     name = "lint"
#     argv = ["pnpm", "lint"]
#
#   Python / uv:
#     [[gates]]
#     name = "lint"
#     argv = ["uv", "run", "ruff", "check", "."]
#
#     [[gates]]
#     name = "test"
#     argv = ["uv", "run", "pytest", "-q"]
#
#   Rust:
#     [[gates]]
#     name = "test"
#     argv = ["cargo", "test", "--all"]

[[gates]]
name = "lint"
argv = ["pnpm", "lint"]

[[gates]]
name = "typecheck"
argv = ["pnpm", "typecheck"]

[[gates]]
name = "test"
argv = ["pnpm", "test"]

[[gates]]
name = "build"
argv = ["pnpm", "build"]


[run]
# Hard wall-clock cap per Claude invocation.
cap_minutes = 30
# Resume-and-retry attempts on a failed gate (warm cache, same session).
max_retries = 2


[burst]
max_issues   = 5
max_hours    = 4
# Legacy: min_headroom kept for back-compat (unused when token caps are
# set). The new gate is token-based: burst stops when session-window
# tokens remaining drops below `min_tokens`.
min_headroom = 8
min_tokens   = 100_000


[batch]
# Issues whose labels start with this prefix are grouped into a batched
# session (warm cache + shared context). Each issue still gets its own
# branch + its own PR — only the Claude session is shared.
# Example: an issue labelled `batch:auth-flow` joins the `auth-flow` batch.
label_prefix = "batch:"
# Hard cap on issues processed in one batched session. The context window
# is the real limit — keep batches small.
max_size = 4


[pipeline]
# Stop after this pipeline stage:
#   pr     — open the PR, do not merge (the old dry-run behaviour).
#   review — open the PR + post an auto-review, do not merge.
#   merge  — full pipeline (default).
stop_after = "merge"
# When stop_after = "merge", also run the auto-review BEFORE merging.
# (When stop_after = "review", auto-review always runs.)
auto_review = false


[claude]
bin = "claude"
# Pin a specific Claude account dir for this project. If unset, the
# orchestrator inherits CLAUDE_CONFIG_DIR from the shell that ran it
# (and falls back to claude's own default, ~/.claude).
# config_dir = "~/.claude-personal"

# Plan caps — token-based, used to compute "% left" in the cockpit and
# to gate burst mode on tight windows. Anthropic does not publish exact
# numbers; the most reliable source is YOUR OWN `/usage` view in Claude
# Code (Settings → Usage). Fill these in once and the bars become real.
# Until set, the cockpit shows raw tokens used + cost without a percent.
# session_token_limit = 5_000_000     # rolling 5h
# weekly_token_limit  = 35_000_000    # rolling 7d


# Optional. Default: ~/Library/Logs/agents-orchestrator/<slug-with-dashes>/
# [logs]
# dir = "~/Library/Logs/agents-orchestrator/repo-name"
